# 仅作配置示例，程序不自动加载 .env。请设置进程环境变量。
AGENT_API_KEY=replace-with-your-key
AGENT_MODEL=replace-with-your-model
AGENT_BASE_URL=https://replace-with-your-provider.example/v1
AGENT_JSON_MODE=json_object

# 推荐在桌面“模型设置”管理多个模型和阶段分配，保存到本机加密 models.json。
# 已存在新版设置时，下列 AGENT_* 全局配置在重启后覆盖默认模型；显式阶段分配优先。
# 所有模型均需兼容 Chat Completions；原生其他协议暂未接入。

# 记忆提取/后台沉淀可分别选模型；未设置时沿用现有模型、地址和密钥。
# AGENT_MEMORY_EXTRACT_MODEL=deepseek-flash
# AGENT_MEMORY_EXTRACT_BASE_URL=https://api.deepseek.com
# AGENT_MEMORY_EXTRACT_API_KEY=replace-with-extraction-key
# AGENT_MEMORY_CONSOLIDATE_MODEL=deepseek-flash
# AGENT_MEMORY_CONSOLIDATE_BASE_URL=https://api.deepseek.com
# AGENT_MEMORY_CONSOLIDATE_API_KEY=replace-with-consolidation-key
AGENT_MEMORY_CONSOLIDATE_ENABLED=true
AGENT_MEMORY_CONSOLIDATE_MIN_NEW=20
AGENT_MEMORY_CONSOLIDATE_COOLDOWN_SECONDS=1800
AGENT_MEMORY_CONSOLIDATE_INTERVAL_SECONDS=86400
AGENT_MEMORY_CONSOLIDATE_BATCH_SIZE=10
AGENT_MEMORY_CONSOLIDATE_CONTEXT_SIZE=5
AGENT_MEMORY_CONSOLIDATE_MAX_MODEL_CALLS=20
AGENT_MEMORY_CONSOLIDATE_MAX_SECONDS=180

# Tool permissions are backend-controlled; bash always asks for confirmation.
# AGENT_TOOL_PERMISSIONS={"level":"execute","allow_container":true,"allow_srt":true,"allow_host_shell":true}
# Trusted preloaded Docker image ID (no automatic pull):
# AGENT_TOOL_CONTAINER_IMAGE=sha256:replace-with-64-hex-image-id
# Optional real-container test image; absence explicitly skips acceptance:
# AGENT_TEST_CONTAINER_IMAGE=sha256:replace-with-64-hex-image-id
