{
  "name": "archive-zero-desktop",
  "productName": "Archive Zero",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run prepare:electron && npm run build && electron .",
    "desktop": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepare:electron": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0"
  }
}
